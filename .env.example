APP_NAME=Simutransアドオン横断検索
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DISCORD_WEBHOOK_URL=

DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# Portal database to read from. Use a separate read-only database user.
PORTAL_DB_DATABASE=
# Optional overrides. If omitted, host/port/user/password/socket use DB_* values.
# Empty credentials are used as-is; leave these lines commented until configured.
# PORTAL_DB_HOST=127.0.0.1
# PORTAL_DB_PORT=3306
# PORTAL_DB_USERNAME=cross_search_readonly
# PORTAL_DB_PASSWORD=
# PORTAL_DB_SOCKET=

MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

NOTION_SECRET=
NOTION_DATABASE_ID=
